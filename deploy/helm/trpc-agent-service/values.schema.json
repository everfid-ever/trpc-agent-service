{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "serviceAccount", "podSecurityContext", "securityContext", "telemetry", "secretProvider", "networkPolicy", "roles"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "serviceAccount": {
      "type": "object",
      "required": ["automountServiceAccountToken"],
      "properties": {"automountServiceAccountToken": {"type": "boolean"}},
      "additionalProperties": false
    },
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "telemetry": {
      "type": "object",
      "required": ["endpoint", "allowInsecure", "serviceVersion"],
      "properties": {
        "endpoint": {"type": "string"},
        "allowInsecure": {"type": "boolean"},
        "serviceVersion": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "secretProvider": {
      "type": "object",
      "required": ["enabled", "mountPath", "readOnly"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mountPath": {"type": "string", "pattern": "^/.*$"},
        "readOnly": {"const": true}
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "dns"],
      "properties": {
        "enabled": {"type": "boolean"},
        "dns": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": {"type": "object"},
            "podSelector": {"type": "object"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": ["gateway", "worker", "channel", "channel-delivery", "preprocess", "artifact", "audit-relay"],
      "properties": {
        "gateway": {"$ref": "#/$defs/role"},
        "worker": {"$ref": "#/$defs/role"},
        "channel": {"$ref": "#/$defs/role"},
        "channel-delivery": {"$ref": "#/$defs/role"},
        "preprocess": {"$ref": "#/$defs/role"},
        "artifact": {"$ref": "#/$defs/role"},
        "audit-relay": {"$ref": "#/$defs/role"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "object",
      "required": ["enabled", "serviceAccountAnnotations", "replicaCount", "existingEnvSecret", "secretProviderClass", "terminationGracePeriodSeconds", "preStopSettleDelay", "env", "service", "pdb", "autoscaling", "resources", "networkPolicy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "serviceAccountAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "replicaCount": {"type": "integer", "minimum": 1},
        "existingEnvSecret": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "secretProviderClass": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 15, "maximum": 3600},
        "preStopSettleDelay": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s)$"},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "service": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "additionalProperties": false,
          "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["type", "port", "annotations"]}}]
        },
        "pdb": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minAvailable": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[1-9][0-9]*%$"}]}
          },
          "additionalProperties": false,
          "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["minAvailable"]}}]
        },
        "autoscaling": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
          },
          "additionalProperties": false,
          "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"]}}]
        },
        "resources": {"type": "object"},
        "networkPolicy": {
          "type": "object",
          "required": ["ingress", "egress"],
          "properties": {
            "ingress": {"type": "array", "items": {"type": "object"}},
            "egress": {"type": "array", "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
