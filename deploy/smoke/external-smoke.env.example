# Copy this file outside the repository, chmod 600 it, and point
# TRPC_EXTERNAL_SMOKE_CONFIG_FILE at the copy. Values are locators only.
# Setting approval to 0 is an intentional, reportable skip; it is not success.
TRPC_EXTERNAL_SMOKE_APPROVED=0

# Fill these only after the matching resource owner authorizes a real run.
TRPC_EXTERNAL_DEEPSEEK_CONFIG_FILE=/absolute/path/to/deepseek.env
TRPC_EXTERNAL_OBJECT_SCAN_CONFIG_FILE=/absolute/path/to/object-scan.env
TRPC_EXTERNAL_IM_CONFIG_FILE=/absolute/path/to/m3-im.env

# References to the reviewed OTEL query plan and Kubernetes dry-run/drain plan.
TRPC_EXTERNAL_OTEL_EVIDENCE_REF=change-ticket-or-runbook-reference
TRPC_EXTERNAL_KUBERNETES_EVIDENCE_REF=change-ticket-or-runbook-reference
