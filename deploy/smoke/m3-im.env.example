# Owner-only file: chmod 600 after copying outside the repository.
# Credential files are separate absolute, owner-only JSON files.
TRPC_M3_IM_PROVIDER_SMOKE=1
TRPC_M3_IM_PROVIDERS=feishu,wecom
TRPC_M3_FEISHU_SECRET_FILE=/absolute/path/to/feishu.json
TRPC_M3_FEISHU_APP_ID=cli_replace
TRPC_M3_FEISHU_MESSAGE_ID=om_replace
TRPC_M3_WECOM_SECRET_FILE=/absolute/path/to/wecom.json
TRPC_M3_WECOM_CORP_ID=ww_replace
TRPC_M3_WECOM_USER_ID=replace-test-user
